function [imgT_1, imgT_2, imgT_3, imgT_4, imgT_5, imgT_6, imgT_7, imgT_8, imgT_9] = imgC(imgS, imgD, N)

iH_S = unique(imgS)';
H_S = sum(iH_S==imgS,2)/N;

jH_D = unique(imgD)';
H_D = sum(jH_D==imgD,2)/N;

imgT_1 = H_S'*iH_S/2;
imgT_2 = (H_S'*(iH_S-2*imgT_1).^2+H_D'*(jH_D.^2))/2;
imgT_3 = (H_S'*H_S).*(H_D'*H_D);
imgT_4 = (H_S'*(iH_S-2*imgT_1).^2-H_D'*(jH_D.^2))/2;
imgT_5 = -H_S'*log(H_S)-H_D'*log(H_D);
imgT_6 = H_D'*(jH_D.^2);
imgT_7 = 1/(1+jH_D.^2).*H_D';
imgT_8 = ;
imgT_9 = ;